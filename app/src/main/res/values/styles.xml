<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D71920</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#080808</item>
        <item name="android:navigationBarColor">#080808</item>
        <item name="android:statusBarColor">#080808</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D71920</item>
        <item name="android:colorBackground">#181818</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:colorControlHighlight">#22FFFFFF</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.68</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:listPreferredItemHeightSmall">56dp</item>
        <item name="android:listPreferredItemPaddingStart">12dp</item>
        <item name="android:listPreferredItemPaddingEnd">12dp</item>
    </style>
</resources>
